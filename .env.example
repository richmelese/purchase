# Used by docker compose (and optionally by `npm run dev` / `npm start`).
# Shared secret between the Next.js BFF and the API; the API rejects requests without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BFF_SHARED_SECRET=

# Port the app is published on (http://localhost:3000)
PORT=3000

# Postgres (used by docker compose's "postgres" service, and read by the backend as DATABASE_URL
# when running outside Docker — see backend/.env.example for the local-dev default).
POSTGRES_USER=psm
POSTGRES_PASSWORD=
POSTGRES_DB=psm
# Host port Postgres is published on, so you can connect a DB client while developing.
POSTGRES_PORT=5437
