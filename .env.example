# Used by docker compose (and optionally by `npm run dev` / `npm start`).
# Shared secret between the Next.js BFF and the API; the API rejects requests without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BFF_SHARED_SECRET=

# Port the app is published on (http://localhost:3000)
PORT=3000
