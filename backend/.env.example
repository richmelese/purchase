# Not read automatically (the backend doesn't load dotenv files) — these are the env vars the
# backend understands, for reference. Set them in your shell, or via scripts/run.mjs / docker-compose.
#
# Connection string for Postgres. Defaults to a local dev Postgres on the port docker-compose's
# "postgres" service publishes — start it with: docker compose up -d postgres (from the repo root).
DATABASE_URL=postgres://psm:psm@localhost:5437/psm

PORT=5000
HOST=127.0.0.1
# Shared secret the BFF must send; requests without it are rejected when this is set.
BFF_SHARED_SECRET=
